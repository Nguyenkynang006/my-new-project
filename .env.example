BIND_ADDR=127.0.0.1

POSTGRES_DB=crm_db
POSTGRES_USER=crm_admin
POSTGRES_PASSWORD=replace_with_long_random_admin_password
CRM_APP_USER=crm_app
CRM_APP_PASSWORD=replace_with_long_random_app_password
PGADMIN_DEFAULT_EMAIL=admin@example.test
PGADMIN_DEFAULT_PASSWORD=replace_with_long_random_pgadmin_password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_long_random_grafana_password

# Docker data-root (dùng cho cAdvisor). Mặc định /var/lib/docker;
# Docker cài qua snap thường là /var/snap/docker/common/var-lib-docker.
# Kiểm tra bằng: docker info --format '{{.DockerRootDir}}'
DOCKER_DATA_ROOT=/var/lib/docker
