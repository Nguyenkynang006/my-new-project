# ============================================================
# CRM Customer Care System — Environment Variables
# Copy this file to .env and replace placeholder values
# NEVER commit the actual .env file to Git
# ============================================================

# PostgreSQL
POSTGRES_DB=crm_db
POSTGRES_USER=crm_app
POSTGRES_PASSWORD=replace_with_strong_password

# Application
APP_PORT=3000
DB_HOST=db
DB_PORT=5432

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.test
PGADMIN_DEFAULT_PASSWORD=replace_with_strong_password

# Grafana (sẽ dùng ở Pha 3)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_strong_password
