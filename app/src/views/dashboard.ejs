<%- include('partials/header') %>

<!-- ── Stats Cards ─────────────────────────────────────────── -->
<div class="stats-grid">
  <div class="stat-card stat-total">
    <div class="stat-icon">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
        <circle cx="9" cy="7" r="4"/>
        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
      </svg>
    </div>
    <div class="stat-info">
      <div class="stat-value"><%= stats.total %></div>
      <div class="stat-label">Tổng khách hàng</div>
    </div>
  </div>

  <div class="stat-card stat-lead">
    <div class="stat-icon">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
      </svg>
    </div>
    <div class="stat-info">
      <div class="stat-value"><%= stats.lead %></div>
      <div class="stat-label">Tiềm năng</div>
    </div>
  </div>

  <div class="stat-card stat-nurturing">
    <div class="stat-icon">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
      </svg>
    </div>
    <div class="stat-info">
      <div class="stat-value"><%= stats.nurturing %></div>
      <div class="stat-label">Đang chăm sóc</div>
    </div>
  </div>

  <div class="stat-card stat-active">
    <div class="stat-icon">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
        <polyline points="22 4 12 14.01 9 11.01"/>
      </svg>
    </div>
    <div class="stat-info">
      <div class="stat-value"><%= stats.active %></div>
      <div class="stat-label">Đang hoạt động</div>
    </div>
  </div>

  <div class="stat-card stat-inactive">
    <div class="stat-icon">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"/>
        <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
      </svg>
    </div>
    <div class="stat-info">
      <div class="stat-value"><%= stats.inactive %></div>
      <div class="stat-label">Ngừng hoạt động</div>
    </div>
  </div>
</div>

<!-- ── Recent Interactions ─────────────────────────────────── -->
<div class="card">
  <div class="card-header">
    <h2 class="card-title">Tương tác gần đây</h2>
    <a href="/customers" class="btn btn-sm btn-ghost">Xem tất cả →</a>
  </div>
  <div class="card-body">
    <% if (recentInteractions.length === 0) { %>
      <div class="empty-state">
        <p>Chưa có tương tác nào được ghi nhận.</p>
      </div>
    <% } else { %>
      <div class="timeline">
        <% recentInteractions.forEach(function(i) { %>
          <div class="timeline-item">
            <div class="timeline-marker type-<%= i.type %>">
              <% if (i.type === 'call') { %>📞
              <% } else if (i.type === 'email') { %>📧
              <% } else if (i.type === 'meeting') { %>🤝
              <% } else { %>📝<% } %>
            </div>
            <div class="timeline-content">
              <div class="timeline-header">
                <a href="/customers/<%= i.customer_id %>" class="timeline-customer"><%= i.customer_name %></a>
                <span class="badge badge-type"><%= typeMap[i.type] %></span>
              </div>
              <div class="timeline-subject"><%= i.subject %></div>
              <% if (i.contact_first) { %>
                <div class="timeline-contact">👤 <%= i.contact_first %> <%= i.contact_last %></div>
              <% } %>
              <div class="timeline-time">
                <%= new Date(i.occurred_at).toLocaleDateString('vi-VN', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' }) %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
