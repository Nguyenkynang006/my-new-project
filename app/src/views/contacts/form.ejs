<%- include('../partials/header') %>

<nav class="breadcrumb">
  <a href="/">Dashboard</a>
  <span class="sep">›</span>
  <a href="/customers">Khách hàng</a>
  <span class="sep">›</span>
  <a href="/customers/<%= customer.id %>"><%= customer.name %></a>
  <span class="sep">›</span>
  <span class="current"><%= contact ? 'Sửa liên hệ' : 'Thêm liên hệ' %></span>
</nav>

<div class="form-card">
  <% if (errors.length > 0) { %>
    <div class="alert alert-error">
      <strong>Vui lòng sửa các lỗi sau:</strong>
      <ul>
        <% errors.forEach(function(e) { %>
          <li><%= e.msg %></li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <form method="POST"
        action="<%= contact && contact.id
          ? '/customers/' + customer.id + '/contacts/' + contact.id + '?_method=PUT'
          : '/customers/' + customer.id + '/contacts' %>"
        class="crm-form" id="contactForm">

    <div class="form-grid">
      <div class="form-group">
        <label for="first_name" class="form-label">Họ <span class="required">*</span></label>
        <input type="text" id="first_name" name="first_name" class="form-input" required
               value="<%= contact ? contact.first_name : '' %>"
               placeholder="VD: Nguyễn">
      </div>

      <div class="form-group">
        <label for="last_name" class="form-label">Tên <span class="required">*</span></label>
        <input type="text" id="last_name" name="last_name" class="form-input" required
               value="<%= contact ? contact.last_name : '' %>"
               placeholder="VD: Văn An">
      </div>

      <div class="form-group">
        <label for="job_title" class="form-label">Chức vụ</label>
        <input type="text" id="job_title" name="job_title" class="form-input"
               value="<%= contact ? (contact.job_title || '') : '' %>"
               placeholder="VD: Giám đốc kinh doanh">
      </div>

      <div class="form-group">
        <label for="contact_email" class="form-label">Email</label>
        <input type="email" id="contact_email" name="email" class="form-input"
               value="<%= contact ? (contact.email || '') : '' %>"
               placeholder="VD: an@company.vn">
      </div>

      <div class="form-group">
        <label for="contact_phone" class="form-label">Số điện thoại</label>
        <input type="text" id="contact_phone" name="phone" class="form-input"
               value="<%= contact ? (contact.phone || '') : '' %>"
               placeholder="VD: 0901-234-567">
      </div>

      <div class="form-group form-group-checkbox">
        <label class="checkbox-label">
          <input type="checkbox" name="is_primary" value="true"
                 <%= contact && contact.is_primary ? 'checked' : '' %>>
          <span class="checkbox-custom"></span>
          <span>Liên hệ chính</span>
        </label>
      </div>
    </div>

    <div class="form-actions">
      <a href="/customers/<%= customer.id %>" class="btn btn-ghost">Hủy</a>
      <button type="submit" class="btn btn-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
          <polyline points="17 21 17 13 7 13 7 21"/>
          <polyline points="7 3 7 8 15 8"/>
        </svg>
        <%= contact && contact.id ? 'Cập nhật' : 'Thêm liên hệ' %>
      </button>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
